---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">Buffstreams</a></h2>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
	}
	h2 a {
		text-decoration: none;
		color: #000;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: #000;
		text-decoration: none;
	}
</style>
